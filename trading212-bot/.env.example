# Trading 212: App -> Einstellungen -> API (Beta) -> API-Schlüssel erzeugen.
# Neue Schlüssel bestehen aus Key + Secret (HTTP Basic Auth).
# Für Demo- und Live-Konto werden JEWEILS EIGENE Schlüssel benötigt.
T212_API_KEY=
T212_API_SECRET=

# Nur für den Echtgeld-Modus (environment: live) – muss exakt so lauten:
# T212_LIVE_CONFIRM=I_ACCEPT_THE_RISK

# Nachrichten (kostenloser Key: https://finnhub.io/register)
FINNHUB_API_KEY=

# Optional: KI-Nachrichtenanalyse mit Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
